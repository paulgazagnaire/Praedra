<Project Sdk="Microsoft.NET.Sdk">

  <!-- B1 own importer: the Classic GData files and TEXTSTRA.DLL to data/classic/. Standalone: no Godot, no core reference, no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Praedra.Importer</AssemblyName>
    <RootNamespace>Praedra.Importer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Praedra.Importer.Tests" />
  </ItemGroup>

</Project>
