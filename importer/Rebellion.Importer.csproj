<Project Sdk="Microsoft.NET.Sdk">

  <!-- B1 own importer: the 1998 GData files and TEXTSTRA.DLL to data/original/. Standalone: no Godot, no core reference, no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Rebellion.Importer</AssemblyName>
    <RootNamespace>Rebellion.Importer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rebellion.Importer.Tests" />
  </ItemGroup>

</Project>
